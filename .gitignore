# Never commit credentials. The Google key lives in
# ~/.config/shona-translate/google-speech-key, outside this repo; these
# patterns are a backstop in case one is ever copied in by mistake.
google-speech-key
*.key
.env
.env.*

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Local leftovers and generated data
*.bak
*.bak-*
*.wav
models/
